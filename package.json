{
  "name": "bee-code",
  "displayName": "Bee Code",
  "description": "BYO-model coding agent: Chat / Builder / Debugger, diff preview with per-file accept.",
  "version": "0.1.0",
  "publisher": "xzyk520",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xzyk520/code_agent.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "code",
    "chatgpt",
    "openai",
    "llm",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "不受信任的工作区只能读取与对话；写文件与执行命令会被拒绝。"
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "依赖真实文件系统与 git（影子检查点），不支持虚拟工作区。"
    }
  },
  "activationEvents": [],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "contributes": {
    "commands": [
      {
        "command": "beeCode.chat.ask",
        "title": "提问（Chat）",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.selection.chat",
        "title": "解释选中代码",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.selection.build",
        "title": "按选中代码生成改动",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.selection.debug",
        "title": "排查选中代码",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.files.pick",
        "title": "选择要阅读的文件",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.model.configure",
        "title": "配置模型（base_url / key / model）",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.proposal.acceptAll",
        "title": "接受全部提案",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.proposal.cancelAcceptAll",
        "title": "取消批量接受",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.proposal.rejectAll",
        "title": "拒绝全部提案",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.checkpoint.restore",
        "title": "恢复到检查点…",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.core.restart",
        "title": "重启内核进程",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.core.showOutput",
        "title": "显示日志",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.exportDiagnostics",
        "title": "导出诊断包（已脱敏）",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.confirm.resetRemembered",
        "title": "清除记住的确认选择",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.new",
        "title": "新建会话",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.pick",
        "title": "历史会话…",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.subagent.configure",
        "title": "配置子代理模型",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.subagent.test",
        "title": "测试子代理连接",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.subagent.clearKey",
        "title": "清除子代理 API Key",
        "category": "Bee Code"
      },      {
        "command": "beeCode.docker.redetect",
        "title": "重新检测 Docker 沙箱",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.workspace.trust",
        "title": "信任/取消信任此工作区",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.model.test",
        "title": "测试模型连接",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.model.clearKey",
        "title": "清除 API Key",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.dev.crashMock",
        "title": "模拟内核崩溃（mock）",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.continue",
        "title": "继续上次的操作",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.regenerate",
        "title": "重新生成上次的提案",
        "category": "Bee Code"
      }
    ],
    "keybindings": [
      {
        "command": "beeCode.selection.chat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      },
      {
        "command": "beeCode.selection.build",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorHasSelection"
      },
      {
        "command": "beeCode.selection.debug",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "beeCode.selection.chat",
          "when": "editorHasSelection && !isInDiffEditor",
          "group": "beeCode@1"
        },
        {
          "command": "beeCode.selection.build",
          "when": "editorHasSelection && !isInDiffEditor",
          "group": "beeCode@2"
        },
        {
          "command": "beeCode.selection.debug",
          "when": "editorHasSelection && !isInDiffEditor",
          "group": "beeCode@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "beeCode",
          "title": "Bee Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "beeCode": [
        {
          "id": "beeCode.chatView",
          "name": "Agent",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Bee Code",
      "properties": {
        "beeCode.core.mode": {
          "type": "string",
          "enum": [
            "python",
            "mock"
          ],
          "default": "python",
          "markdownDescription": "内核模式：`python` 拉起真实内核；`mock` 用内置假内核（只调壳时用）。"
        },
        "beeCode.core.pythonPath": {
          "type": "string",
          "default": "python",
          "markdownDescription": "Python 解释器路径。留 `python` 走 PATH；conda 环境请填绝对路径（如 `D:\\\\APP\\\\conda\\\\envs\\\\beeagent\\\\python.exe`）。"
        },
        "beeCode.core.coreRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "包含 `beecode/` 包的目录（会加入 `PYTHONPATH`）。留空则自动探测：先看工作区根（开发模式），再看扩展安装目录（安装模式）。"
        },
        "beeCode.core.cwd": {
          "type": "string",
          "default": "${workspaceFolder}",
          "markdownDescription": "内核进程的工作目录，默认第一个工作区根。"
        },
        "beeCode.core.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "传递给解释器的参数。**留空表示 `-m beecode`**；调试内核时可改成 `[\"-m\",\"debugpy\",\"--listen\",\"5679\",\"-m\",\"beecode\"]`。"
        },
        "beeCode.model.baseUrl": {
          "type": "string",
          "scope": "machine",
          "order": 1,
          "default": "",
          "markdownDescription": "OpenAI 兼容端点，例如 `https://api.deepseek.com/v1`（**不含** `/chat/completions`）。"
        },
        "beeCode.model.model": {
          "type": "string",
          "scope": "window",
          "order": 2,
          "default": "",
          "markdownDescription": "模型名，例如 `deepseek-chat`。"
        },
        "beeCode.model.apiKeyId": {
          "type": "string",
          "scope": "machine",
          "order": 3,
          "default": "beeCode.apiKey.default",
          "markdownDescription": "`SecretStorage` 里的键名。**密钥本身永不写入 settings.json。**"
        },
        "beeCode.model.temperature": {
          "type": "number",
          "default": 0.2
        },
        "beeCode.model.contextWindow": {
          "type": "number",
          "scope": "window",
          "order": 6,
          "default": 32768,
          "minimum": 4096,
          "maximum": 2000000,
          "markdownDescription": "模型上下文窗口（token）。轮内压缩按「窗口 × 70%」触发，影响长任务能否继续。"
        },
        "beeCode.model.maxOutputTokens": {
          "type": "number",
          "default": 8192
        },
        "beeCode.model.supportsVision": {
          "type": "string",
          "scope": "window",
          "order": 5,
          "enum": ["auto", "on", "off"],
          "enumDescriptions": ["先带图尝试，被拒后自动降级并记住", "强制当作视觉模型", "强制当作纯文本模型"],
          "default": "auto",
          "markdownDescription": "模型能否接收图片。`auto` = 先带图尝试；若服务端明确拒绝图片，自动改为文字描述并记住（不靠模型名枚举）。"
        },
        "beeCode.model.supportsTools": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "端点是否支持原生 function calling；关掉后内核走 JSON 模式降级。"
        },
        "beeCode.permissions.mode": {
          "type": "string",
          "scope": "window",
          "order": 20,
          "enum": ["plan", "manual", "acceptEdits", "auto", "bypass"],
          "enumDescriptions": [
            "只读：不允许改文件、不允许执行命令",
            "手动：写文件与执行命令都要确认（默认）",
            "自动接受编辑：写文件不再逐次确认，执行命令仍要确认",
            "自动：低风险操作自动放行（写文件放行，命令仍需确认）",
            "全放行：不做任何确认，只应在容器/虚拟机里使用"
          ],
          "default": "manual",
          "markdownDescription": "权限模式。规则（allow/ask/deny）优先于模式。"
        },
        "beeCode.permissions.allow": {
          "type": "array",
          "scope": "window",
          "order": 21,
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "允许规则，例如 `Read(src/**)`、`Run(npm test *)`。优先级：deny > ask > allow。"
        },
        "beeCode.permissions.ask": {
          "type": "array",
          "scope": "window",
          "order": 22,
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "必须确认的规则，例如 `Edit(.github/**)`。"
        },
        "beeCode.permissions.deny": {
          "type": "array",
          "scope": "window",
          "order": 23,
          "items": { "type": "string" },
          "default": [],
          "markdownDescription": "禁止规则，例如 `Run(git push *)`、`Edit(.env*)`。**deny 永远优先**，allow 不能挖例外。"
        },
        "beeCode.permissions.sandbox": {
          "type": "string",
          "scope": "window",
          "order": 24,
          "enum": ["off", "docker", "auto"],
          "enumDescriptions": ["直接在宿主执行（仅策略约束）", "强制在 docker 容器内执行", "有 docker 就用，没有则直连"],
          "default": "off",
          "markdownDescription": "命令执行的隔离级别。docker 模式会以 `--network none --read-only` 运行，见文档 §12.4。"
        },
        "beeCode.permissions.dockerImage": {
          "type": "string",
          "scope": "window",
          "order": 25,
          "default": "node:22-alpine",
          "markdownDescription": "沙箱镜像（需要包含你要执行的运行时，例如 node/python）。"
        },
        "beeCode.permissions.fullAccess": {
          "type": "boolean",
          "scope": "window",
          "order": 27,
          "default": false,
          "markdownDescription": "开放完整权限：命令与写文件不再逐次确认（**不**解除「未受信任工作区只读」与「工作区外需确认」）。"
        },
        "beeCode.permissions.requireTrust": {
          "type": "boolean",
          "scope": "window",
          "order": 26,
          "default": true,
          "markdownDescription": "是否要求工作区被显式信任（不受信任时禁写、禁命令）。"
        },        "beeCode.focus.autoAttach": {
          "type": "boolean",
          "scope": "window",
          "order": 41,
          "default": true,
          "markdownDescription": "发送消息时自动附上光标所在的**整个函数**（不在函数里则取上下若干行）。"
        },
        "beeCode.focus.fallbackLines": {
          "type": "number",
          "scope": "window",
          "order": 42,
          "default": 30,
          "minimum": 5,
          "maximum": 200,
          "markdownDescription": "光标不在函数里时，向上/向下各取多少行。"
        },
        "beeCode.focus.maxLines": {
          "type": "number",
          "scope": "window",
          "order": 43,
          "default": 300,
          "minimum": 20,
          "maximum": 2000,
          "markdownDescription": "函数超过这么多行就退化成「光标上下 N 行」，避免一次送几千行。"
        },
        "beeCode.focus.highlight": {
          "type": "boolean",
          "scope": "window",
          "order": 44,
          "default": true,
          "markdownDescription": "发送时在编辑器里用虚线框高亮 agent 实际读取的代码范围（5 秒后自动消失）。"
        },
        "beeCode.subagent.enabled": {
          "type": "boolean",
          "scope": "window",
          "order": 30,
          "default": true,
          "markdownDescription": "是否允许主代理派生子代理（只读探索）。关闭后主代理没有 `spawn_subagent` 工具。"
        },
        "beeCode.subagent.baseUrl": {
          "type": "string",
          "scope": "machine",
          "order": 31,
          "default": "",
          "markdownDescription": "子代理的 OpenAI 兼容端点。留空 = 沿用主代理 `beeCode.model.baseUrl`。"
        },
        "beeCode.subagent.model": {
          "type": "string",
          "scope": "window",
          "order": 32,
          "default": "",
          "markdownDescription": "子代理的模型名。留空 = 沿用主代理 `beeCode.model.model`（建议用便宜/快的模型）。"
        },
        "beeCode.subagent.apiKeyId": {
          "type": "string",
          "scope": "machine",
          "order": 33,
          "default": "beeCode.apiKey.subagent",
          "markdownDescription": "子代理密钥在 `SecretStorage` 里的键名。密钥本身永不写入 settings.json；留空则沿用主代理密钥。"
        },
        "beeCode.subagent.maxSteps": {
          "type": "number",
          "scope": "window",
          "order": 34,
          "default": 8,
          "minimum": 1,
          "maximum": 12,
          "markdownDescription": "子代理最多走几步（上限 12）。"
        },
        "beeCode.subagent.supportsVision": {
          "type": "string",
          "scope": "window",
          "order": 35,
          "enum": ["auto", "on", "off"],
          "enumDescriptions": ["先带图尝试，被拒后自动降级并记住", "强制当作视觉模型", "强制当作纯文本模型"],
          "default": "auto",
          "markdownDescription": "子代理模型能否接收图片。"
        },        "beeCode.review.granularity": {
          "type": "string",
          "enum": [
            "function",
            "change",
            "file"
          ],
          "default": "function",
          "markdownDescription": "Keep/Undo 的分组粒度。"
        },
        "beeCode.agent.maxSteps": {
          "type": "number",
          "default": 30
        },
        "beeCode.agent.toolTimeoutMs": {
          "type": "number",
          "default": 30000
        },
        "beeCode.checkpoint.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "写入前落影子 git 快照（`<globalStorage>/shadow.git`），用于整轮 Restore。"
        },
        "beeCode.checkpoint.retention": {
          "type": "number",
          "default": 50
        }
      }
    }
  },
  "dependencies": {
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "typescript": "6.0.3"
  }
}
