{
  "name": "bee-code",
  "displayName": "Bee Code",
  "description": "BYO-model coding agent: Chat / Builder / Debugger, diff preview with per-file accept.",
  "version": "0.1.0",
  "publisher": "xzyk520",
  "license": "MIT",
  "icon": "media/icon-128.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/xzyk520/code_agent.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "extensionKind": [
    "workspace"
  ],
  "categories": [
    "Programming Languages",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "ai",
    "agent",
    "code",
    "chatgpt",
    "openai",
    "llm",
    "mcp"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Untrusted workspaces allow read-only chat; file writes and command execution are denied."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires a real filesystem and git (shadow checkpoints); virtual workspaces are not supported."
    }
  },
  "activationEvents": [
    "onView:beeCode.chatView",
    "onView:beeCode.libraryView"
  ],
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.webview.json --noEmit",
    "vscode:prepublish": "node esbuild.mjs --production",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies",
    "bundle:python": "node scripts/bundle-python.mjs",
    "package:win": "node scripts/package-platform.mjs win32-x64",
    "package:mac": "node scripts/package-platform.mjs darwin-arm64",
    "package:linux": "node scripts/package-platform.mjs linux-x64",
    "package:platform": "node scripts/package-platform.mjs"
  },
  "contributes": {
    "commands": [
      {
        "command": "beeCode.ui.language.switch",
        "title": "Switch language",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.chat.ask",
        "title": "Ask (Chat)",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.selection.chat",
        "title": "Explain selection",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.selection.build",
        "title": "Generate changes from selection",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.selection.debug",
        "title": "Debug selection",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.files.pick",
        "title": "Pick files to read",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.model.configure",
        "title": "Configure model (base_url / key / model)",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.proposal.acceptAll",
        "title": "Accept all proposals",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.proposal.cancelAcceptAll",
        "title": "Cancel accept-all",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.proposal.rejectAll",
        "title": "Reject all proposals",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.checkpoint.restore",
        "title": "Restore checkpoint…",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.core.restart",
        "title": "Restart core process",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.core.setup",
        "title": "Set up Python core",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.core.showOutput",
        "title": "Show logs",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.exportDiagnostics",
        "title": "Export diagnostics (redacted)",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.confirm.resetRemembered",
        "title": "Clear remembered confirmations",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.new",
        "title": "New session",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.pick",
        "title": "History sessions…",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.summary.configure",
        "title": "Configure summary model",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.subagent.configure",
        "title": "Configure subagent model",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.subagent.test",
        "title": "Test subagent connection",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.subagent.clearKey",
        "title": "Clear subagent API key",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.docker.redetect",
        "title": "Re-detect Docker sandbox",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.workspace.trust",
        "title": "Trust / untrust this workspace",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.model.test",
        "title": "Test model connection",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.model.clearKey",
        "title": "Clear API key",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.dev.crashMock",
        "title": "Simulate core crash (mock)",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.continue",
        "title": "Continue last operation",
        "category": "Bee Code"
      },
      {
        "command": "beeCode.session.regenerate",
        "title": "Regenerate last proposal",
        "category": "Bee Code"
      }
    ],
    "keybindings": [
      {
        "command": "beeCode.selection.chat",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "editorHasSelection"
      },
      {
        "command": "beeCode.selection.build",
        "key": "ctrl+alt+b",
        "mac": "cmd+alt+b",
        "when": "editorHasSelection"
      },
      {
        "command": "beeCode.selection.debug",
        "key": "ctrl+alt+d",
        "mac": "cmd+alt+d",
        "when": "editorHasSelection"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "beeCode.selection.chat",
          "when": "editorHasSelection && !isInDiffEditor",
          "group": "beeCode@1"
        },
        {
          "command": "beeCode.selection.build",
          "when": "editorHasSelection && !isInDiffEditor",
          "group": "beeCode@2"
        },
        {
          "command": "beeCode.selection.debug",
          "when": "editorHasSelection && !isInDiffEditor",
          "group": "beeCode@3"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "beeCode",
          "title": "Bee Code",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "beeCode": [
        {
          "id": "beeCode.chatView",
          "name": "Agent",
          "type": "webview"
        },
        {
          "id": "beeCode.libraryView",
          "name": "Skills & MCP",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Bee Code",
      "properties": {
        "beeCode.ui.fontSize": {
          "type": "number",
          "default": 14,
          "minimum": 10,
          "maximum": 24,
          "markdownDescription": "Base font size for the chat panel, in CSS pixels. Default 14; increase it if the conversation text feels too small."
        },
        "beeCode.ui.language": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ],
          "default": "en",
          "markdownDescription": "UI language for panels, logs, hints and notifications. Default: English (`en`). Model prompts and tool descriptions are always English; model replies follow the user's language."
        },
        "beeCode.core.mode": {
          "type": "string",
          "enum": [
            "python",
            "mock"
          ],
          "default": "python",
          "markdownDescription": "Core mode: `python` starts the real core; `mock` uses the built-in fake core for shell-only work."
        },
        "beeCode.core.pythonPath": {
          "type": "string",
          "default": "auto",
          "markdownDescription": "Python interpreter. `auto` prefers the bundled runtime under `runtime/<platform>-<arch>/`, then falls back to PATH. Use an absolute path to force a specific interpreter."
        },
        "beeCode.core.coreRoot": {
          "type": "string",
          "default": "",
          "markdownDescription": "Directory containing the `beecode/` package (added to `PYTHONPATH`). Empty = auto-detect: workspace root first, then the extension directory."
        },
        "beeCode.core.cwd": {
          "type": "string",
          "default": "${workspaceFolder}",
          "markdownDescription": "Working directory for the core process. Defaults to the first workspace root."
        },
        "beeCode.core.args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Interpreter arguments. Empty means `-m beecode`. For debugging use debugpy arguments."
        },
        "beeCode.model.baseUrl": {
          "type": "string",
          "scope": "machine",
          "order": 1,
          "default": "",
          "markdownDescription": "OpenAI-compatible base URL, e.g. `https://api.deepseek.com/v1` (do not include `/chat/completions`)."
        },
        "beeCode.model.model": {
          "type": "string",
          "scope": "window",
          "order": 2,
          "default": "",
          "markdownDescription": "Model name, e.g. `deepseek-chat`."
        },
        "beeCode.model.apiKeyId": {
          "type": "string",
          "scope": "machine",
          "order": 3,
          "default": "beeCode.apiKey.default",
          "markdownDescription": "SecretStorage key name. The key itself is never written to settings.json."
        },
        "beeCode.model.temperature": {
          "type": "number",
          "default": 0.2
        },
        "beeCode.model.reasoningReplay": {
          "type": "string",
          "scope": "window",
          "order": 7,
          "enum": [
            "auto",
            "always",
            "never"
          ],
          "enumDescriptions": [
            "Default: do not replay; add reasoning_content automatically if the server rejects the request",
            "Always replay reasoning with assistant messages",
            "Never replay (for models that forbid it)"
          ],
          "default": "auto",
          "markdownDescription": "Reasoning replay policy. Reasoning is shown to the user only; it is not sent to the model or persisted."
        },
        "beeCode.model.contextWindow": {
          "type": "number",
          "scope": "window",
          "order": 6,
          "default": 32768,
          "minimum": 4096,
          "maximum": 2000000,
          "markdownDescription": "Model context window in tokens. In-turn compaction triggers at 70% of the window."
        },
        "beeCode.model.maxOutputTokens": {
          "type": "number",
          "default": 8192
        },
        "beeCode.model.supportsVision": {
          "type": "string",
          "scope": "window",
          "order": 5,
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Try with images; degrade and remember on rejection",
            "Force vision support",
            "Force text-only"
          ],
          "default": "auto",
          "markdownDescription": "Whether the model accepts images. `auto` tries images and remembers an explicit rejection."
        },
        "beeCode.model.supportsTools": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Whether the endpoint supports native function calling; disable to fall back to JSON mode."
        },
        "beeCode.permissions.mode": {
          "type": "string",
          "scope": "window",
          "order": 20,
          "enum": [
            "plan",
            "manual",
            "acceptEdits",
            "auto",
            "bypass"
          ],
          "enumDescriptions": [
            "Read-only: no file writes, no command execution",
            "Manual: confirm writes and commands (default)",
            "Accept edits: writes are no longer confirmed; commands still are",
            "Auto: allow low-risk writes; commands still need confirmation",
            "Bypass: no confirmations; only use inside a container or VM"
          ],
          "default": "manual",
          "markdownDescription": "Permission mode. Rules (allow/ask/deny) take precedence."
        },
        "beeCode.permissions.allow": {
          "type": "array",
          "scope": "window",
          "order": 21,
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Allow rules, e.g. `Read(src/**)` or `Run(npm test *)`. Precedence: deny > ask > allow."
        },
        "beeCode.permissions.ask": {
          "type": "array",
          "scope": "window",
          "order": 22,
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Ask rules, e.g. `Edit(.github/**)`."
        },
        "beeCode.permissions.deny": {
          "type": "array",
          "scope": "window",
          "order": 23,
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Deny rules, e.g. `Run(git push *)` or `Edit(.env*)`. Deny always wins."
        },
        "beeCode.permissions.sandbox": {
          "type": "string",
          "scope": "window",
          "order": 24,
          "enum": [
            "off",
            "docker",
            "auto"
          ],
          "enumDescriptions": [
            "Run directly on the host (policy-only)",
            "Always run in Docker",
            "Use Docker when available, otherwise run directly"
          ],
          "default": "off",
          "markdownDescription": "Command isolation level. Docker uses `--network none --read-only`; see architecture §12.4."
        },
        "beeCode.permissions.dockerImage": {
          "type": "string",
          "scope": "window",
          "order": 25,
          "default": "node:22-alpine",
          "markdownDescription": "Sandbox image; it must contain the runtime you execute (e.g. node/python)."
        },
        "beeCode.permissions.fullAccess": {
          "type": "boolean",
          "scope": "window",
          "order": 27,
          "default": false,
          "markdownDescription": "Full access: no per-write/command confirmation. Untrusted-workspace and outside-workspace restrictions still apply."
        },
        "beeCode.permissions.requireTrust": {
          "type": "boolean",
          "scope": "window",
          "order": 26,
          "default": true,
          "markdownDescription": "Require explicit workspace trust; untrusted workspaces are read-only and cannot run commands."
        },
        "beeCode.attachments.maxCount": {
          "type": "number",
          "scope": "window",
          "order": 48,
          "default": 10,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "Maximum code/file attachments per turn."
        },
        "beeCode.attachments.maxCharsPerItem": {
          "type": "number",
          "scope": "window",
          "order": 49,
          "default": 40000,
          "minimum": 2000,
          "maximum": 500000,
          "markdownDescription": "Maximum characters per attachment; longer content is truncated and marked."
        },
        "beeCode.attachments.maxTotalChars": {
          "type": "number",
          "scope": "window",
          "order": 50,
          "default": 120000,
          "minimum": 10000,
          "maximum": 1000000,
          "markdownDescription": "Maximum total attachment characters per turn."
        },
        "beeCode.focus.autoAttach": {
          "type": "boolean",
          "scope": "window",
          "order": 41,
          "default": true,
          "markdownDescription": "Automatically attach the whole function at the cursor (or surrounding lines when outside a function)."
        },
        "beeCode.focus.fallbackLines": {
          "type": "number",
          "scope": "window",
          "order": 42,
          "default": 30,
          "minimum": 5,
          "maximum": 200,
          "markdownDescription": "Lines above/below the cursor when outside a function."
        },
        "beeCode.focus.maxLines": {
          "type": "number",
          "scope": "window",
          "order": 43,
          "default": 300,
          "minimum": 20,
          "maximum": 2000,
          "markdownDescription": "Functions longer than this fall back to N surrounding lines to avoid sending thousands of lines."
        },
        "beeCode.focus.highlight": {
          "type": "boolean",
          "scope": "window",
          "order": 44,
          "default": true,
          "markdownDescription": "Highlight the code range read by the agent in the editor for 5 seconds."
        },
        "beeCode.summary.model": {
          "type": "string",
          "scope": "window",
          "order": 55,
          "default": "",
          "markdownDescription": "Model used for history summaries; empty = main agent model."
        },
        "beeCode.summary.baseUrl": {
          "type": "string",
          "scope": "machine",
          "order": 56,
          "default": "",
          "markdownDescription": "Summary model base URL; empty = main agent URL."
        },
        "beeCode.summary.apiKeyId": {
          "type": "string",
          "scope": "machine",
          "order": 57,
          "default": "beeCode.summaryApiKey",
          "markdownDescription": "SecretStorage key for the summary model; empty = main key."
        },
        "beeCode.subagent.enabled": {
          "type": "boolean",
          "scope": "window",
          "order": 30,
          "default": true,
          "markdownDescription": "Allow the main agent to spawn read-only exploration subagents. Disabling removes `spawn_subagent`."
        },
        "beeCode.subagent.baseUrl": {
          "type": "string",
          "scope": "machine",
          "order": 31,
          "default": "",
          "markdownDescription": "Subagent OpenAI-compatible endpoint. Empty = `beeCode.model.baseUrl`."
        },
        "beeCode.subagent.model": {
          "type": "string",
          "scope": "window",
          "order": 32,
          "default": "",
          "markdownDescription": "Subagent model. Empty = main model (a cheaper/faster model is recommended)."
        },
        "beeCode.subagent.apiKeyId": {
          "type": "string",
          "scope": "machine",
          "order": 33,
          "default": "beeCode.apiKey.subagent",
          "markdownDescription": "SecretStorage key for the subagent. Empty = main key."
        },
        "beeCode.subagent.maxSteps": {
          "type": "number",
          "scope": "window",
          "order": 34,
          "default": 8,
          "minimum": 1,
          "maximum": 12,
          "markdownDescription": "Maximum subagent steps (up to 12)."
        },
        "beeCode.subagent.supportsVision": {
          "type": "string",
          "scope": "window",
          "order": 35,
          "enum": [
            "auto",
            "on",
            "off"
          ],
          "enumDescriptions": [
            "Try with images; degrade and remember on rejection",
            "Force vision support",
            "Force text-only"
          ],
          "default": "auto",
          "markdownDescription": "Whether the subagent model accepts images."
        },
        "beeCode.review.granularity": {
          "type": "string",
          "enum": [
            "function",
            "change",
            "file"
          ],
          "default": "function",
          "markdownDescription": "Grouping granularity for Keep/Undo."
        },
        "beeCode.agent.largeTaskSteps": {
          "type": "number",
          "scope": "window",
          "order": 45,
          "default": 24,
          "minimum": 1,
          "maximum": 60,
          "markdownDescription": "Step limit for large tasks (normal tasks use `beeCode.agent.maxSteps`)."
        },
        "beeCode.agent.maxTurnTokens": {
          "type": "number",
          "scope": "window",
          "order": 46,
          "default": 200000,
          "minimum": 10000,
          "maximum": 2000000,
          "markdownDescription": "Per-turn token budget (input + output). When exhausted the agent wraps up and reports remaining work."
        },
        "beeCode.agent.largeTaskSeconds": {
          "type": "number",
          "scope": "window",
          "order": 51,
          "default": 1800,
          "minimum": 60,
          "maximum": 14400,
          "markdownDescription": "Model-response timeout for large tasks in seconds; tool time is excluded. Normal tasks use `maxTurnSeconds`."
        },
        "beeCode.agent.maxTurnSeconds": {
          "type": "number",
          "scope": "window",
          "order": 47,
          "default": 600,
          "minimum": 60,
          "maximum": 7200,
          "markdownDescription": "Model-response timeout in seconds; tool time is excluded. See `largeTaskSeconds` for large tasks."
        },
        "beeCode.agent.maxSteps": {
          "type": "number",
          "default": 30
        },
        "beeCode.agent.modelFirstTokenSeconds": {
          "type": "number",
          "scope": "window",
          "default": 60,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "First-token timeout in seconds; exceeding it stops the turn."
        },
        "beeCode.agent.modelIdleSeconds": {
          "type": "number",
          "scope": "window",
          "default": 45,
          "minimum": 5,
          "maximum": 600,
          "markdownDescription": "Maximum idle time between streaming tokens in seconds."
        },
        "beeCode.agent.maxToolCallsPerBatch": {
          "type": "number",
          "scope": "window",
          "default": 8,
          "minimum": 1,
          "maximum": 32,
          "markdownDescription": "Maximum tool calls per assistant message; excess calls receive an error and require batching."
        },
        "beeCode.agent.toolTimeoutMs": {
          "type": "number",
          "default": 30000,
          "markdownDescription": "Normal tool timeout in ms. Commands and subagents use `longToolTimeoutMs`."
        },
        "beeCode.agent.longToolTimeoutMs": {
          "type": "number",
          "scope": "window",
          "default": 600000,
          "minimum": 30000,
          "maximum": 3600000,
          "markdownDescription": "Timeout for long tools (run_command, spawn_subagent) in ms; tool time is excluded from model-response timeouts."
        },
        "beeCode.checkpoint.enabled": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Create a shadow-git snapshot before writes (`<globalStorage>/shadow.git`) for whole-turn Restore."
        },
        "beeCode.checkpoint.retention": {
          "type": "number",
          "default": 50
        }
      }
    }
  },
  "dependencies": {
    "ignore": "^5.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.24.0",
    "mermaid": "^12.2.0",
    "typescript": "6.0.3"
  }
}
